                    </phenotype>
                    <phenotype name="resistant">
                        <restriction onLocus="x" toAllele="resistant"/>
                        <max_killing_rate>2.3</max_killing_rate>
                        <IC50 mean="0.024" distr="lognormal" CV="0.0"/>
                        <slope>7</slope>
                    </phenotype>
                </PD>
                <PK>
                    <negligible_concentration>0.001</negligible_concentration>
                    <k  mean="0.861" />
                    <m_exponent>0</m_exponent>
                    <k_a mean="2.16"/>
                    <vol_dist mean="18.4" />
                    <compartment2>
                        <k12 mean="1.7"/>
                        <k21 mean="0.46"/>
                    </compartment2>
                </PK>
            </drug>
        </drugs>
