    <parasiteGenetics samplingMode="tracking">
        <!-- Define name/freq/fitness of the locus/alleles defined in the drugPD code -->
        <locus name="x">
            <allele fitness="1" initialFrequency="1.0" name="sensitive"/>  <!-- Only model one genotype for which we will vary the sensitivity to SPAQ and the prophylactic period provided by SPAQ -->
            <allele fitness="1" initialFrequency="0.0" name="resistant"/>
        </locus>
    </parasiteGenetics>
    <diagnostics>
        <diagnostic name="Deterministic_diagnostic">
            <deterministic minDensity="@detectionLimit@"/>
        </diagnostic>
    </diagnostics>
    <pharmacology>
        <treatments>
            <schedule name="ACT"> <!-- Define the dosage schedule for the first-line treatment (an ACT)  --> 
                <medicate drug="DH" hour="0" mg="4"/> <!-- artmeisnine derivative (in our case:  Dihydroartemisinine)  -->
                <medicate drug="PPQ" hour="0" mg="30"/> <!-- partner drug (in our case: piperaquine)  -->
                <medicate drug="DH" hour="24" mg="4"/>
                <medicate drug="PPQ" hour="24" mg="30"/>
                <medicate drug="DH" hour="48" mg="4"/>
                <medicate drug="PPQ" hour="48" mg="30"/>
            </schedule>
            <schedule name="SPAQ"> <!-- Define the dosage schedule for the drug combination used for SMC --> 
                <medicate drug="SP" hour="0" mg="250"/> <!-- sulfadoxine-pyrimethamine  --> 
                <medicate drug="AQ" hour="0" mg="76.5"/> <!-- amodiaquine   --> 
                <medicate drug="DEAQ" hour="0" mg="76.5"/> <!-- desethylamodiaquine (active metabolite of amodiaquine, it is modelled as a separated drug, see the details in the paper)   --> 
                <medicate drug="AQ" hour="24" mg="76.5"/>
                <medicate drug="DEAQ" hour="24" mg="76.5"/>
                <medicate drug="AQ" hour="48" mg="76.5"/>
                <medicate drug="DEAQ" hour="48" mg="76.5"/>
            </schedule>
            <dosages name="SPAQ">
                <age lowerbound="0" dose_mult="1"/> <!-- adjust dosage by age range  -->
                <age lowerbound="1" dose_mult="2"/>
                <age lowerbound="5" dose_mult="3"/>
                <age lowerbound="10" dose_mult="4"/>
            </dosages>
            <dosages name="ACT">
                <multiply by="kg"/> <!-- adjust dosage by weight  --> 
            </dosages>
            <dosages name="SP">
                <age lowerbound="0" dose_mult="1"/> <!-- adjust dosage by age range  -->
                <age lowerbound="1" dose_mult="2"/>
                <age lowerbound="5" dose_mult="3"/>
                <age lowerbound="10" dose_mult="4"/>
            </dosages>
        </treatments>
        <drugs>
            <drug abbrev="PPQ"> <!-- Piperaquine was equally efficient against both sensitive and resistant parasites --> 
                <PD>
                    <phenotype name="sensitive">
                        <restriction onLocus="x" toAllele="sensitive"/>
                        <max_killing_rate>3.45</max_killing_rate>
                        <IC50 mean="0.020" distr="lognormal" CV="0.0"/>
                        <slope>6</slope>
                    </phenotype>
                    <phenotype name="resistant">
                        <restriction onLocus="x" toAllele="resistant"/>
                        <max_killing_rate>3.45</max_killing_rate>
                        <IC50 mean="0.020" distr="lognormal" CV="0.0"/>
                        <slope>6</slope>
                    </phenotype>
                </PD>
                <PK>
                    <negligible_concentration>0.005</negligible_concentration>
                    <k  mean="0.46" />
                    <m_exponent>0.25</m_exponent>
                    <k_a mean="11.16"/>
                    <vol_dist mean="173" />
                    <compartment2>
                        <k12 mean="8.46242774566474"/>
                        <k21 mean="3.3058064516129035"/>
                    </compartment2>
                </PK>
            </drug>
            <drug abbrev="DH"> <!-- Dihydroartemisinine was equally efficient against both sensitive and resistant parasites --> 
                <PD>
                    <phenotype name="sensitive">
                        <restriction onLocus="x" toAllele="sensitive"/>
                        <max_killing_rate>27.6</max_killing_rate>
                        <IC50 mean="0.009" distr="lognormal" CV="0.0"/>       
                        <slope>4</slope>
                    </phenotype>
                    <phenotype name="resistant">
                        <restriction onLocus="x" toAllele="resistant"/>
                        <max_killing_rate>27.6</max_killing_rate>
                        <IC50 mean="0.009" distr="lognormal" CV="0.0"/>       
                        <slope>4</slope>
                    </phenotype>
                </PD>
                <PK>
                        <negligible_concentration>1e-17</negligible_concentration>
                        <k mean="19.8" /> 
                        <m_exponent>0.0</m_exponent>
                        <vol_dist mean="8" />
                </PK>
            </drug>
            <drug abbrev="SP"> <!-- SP was equally efficient against both sensitive and resistant parasites --> 
                <PD>
                    <phenotype name="sensitive">
                        <restriction onLocus="x" toAllele="sensitive"/>
                        <max_killing_rate>2.303</max_killing_rate>
                        <IC50 mean="0.5" distr="lognormal" CV="0.0"/>
                        <slope>2.1</slope>
                    </phenotype>
                    <phenotype name="resistant">
                        <restriction onLocus="x" toAllele="resistant"/>
                        <max_killing_rate>2.303</max_killing_rate>
                        <IC50 mean="0.5" distr="lognormal" CV="0.0"/>
                        <slope>2.1</slope>
                    </phenotype>
                </PD>
                <PK>
                    <negligible_concentration>0.001</negligible_concentration>
                    <k mean="0.1197732"/> 
                    <m_exponent>0.0</m_exponent>
                    <k_a mean="12.504"/>
                    <vol_dist mean="0.2938889" />
                    <compartment2>
                        <k12 mean="0"/>
                        <k21 mean="0"/>
                    </compartment2>
                </PK>
            </drug>
            <drug abbrev="AQ"> <!-- AQ was equally efficient against both sensitive and resistant parasites --> 
                <PD>
                    <phenotype name="sensitive">
                        <restriction onLocus="x" toAllele="sensitive"/>
                        <max_killing_rate>2.3</max_killing_rate>
                        <IC50 mean="0.0044" distr="lognormal" CV="0.0"/>
                        <slope>7</slope>
                    </phenotype>
                    <phenotype name="resistant">
                        <restriction onLocus="x" toAllele="resistant"/>
                        <max_killing_rate>2.3</max_killing_rate>
                        <IC50 mean="0.0044" distr="lognormal" CV="0.0"/>
                        <slope>7</slope>
                    </phenotype>
                </PD>
                <PK>
                <negligible_concentration>0.0005</negligible_concentration>
                    <k  mean="42" />
                    <m_exponent>0</m_exponent>
                    <k_a mean="2.16"/>
                    <vol_dist mean="8" />
                    <compartment2>
                        <k12 mean="51"/>
                        <k21 mean="1.457143"/>
                    </compartment2>
                </PK>
            </drug>
            <drug abbrev="DEAQ"> <!-- DEAQ was equally efficient against both sensitive and resistant parasites --> 
                <PD>
                    <phenotype name="sensitive">
                        <restriction onLocus="x" toAllele="sensitive"/>
                        <max_killing_rate>2.3</max_killing_rate>
                        <IC50 mean="0.024" distr="lognormal" CV="0.0"/>
