    <interventions name="SMC specification"> <!-- Deployment of SMC -->
        <human>
            <component id="SMC" name="SMC"> 
                <treatPKPD dosage="SPAQ" schedule="SPAQ"/>   <!-- Define the drugs that will be used for SMC and define that they are modelled using PK/PD modelling -->
            </component>
            <deployment name="SMC"> <!-- Assumed different children recieved SMC at each cycle -->
                <component id="SMC"/>
                <timed>
                <deploy coverage="@smc_coverage@" minAge="0.25" maxAge="5" time="@smc_1_1@"/> 
                <deploy coverage="@smc_coverage@" minAge="0.25" maxAge="5" time="@smc_1_2@"/>  <!-- Deployment in 2001 -->
                <deploy coverage="@smc_coverage@" minAge="0.25" maxAge="5" time="@smc_1_3@"/>
