    <interventions name="CC_STEP">
        <vectorPop>
            <intervention name="larviciding">
                <!-- Example larviciding (made up values) -->
                <description>
                    <anopheles mosquito="gambiae_indoor">
                        <emergenceReduction initial="@EIR_reduction@">                                                          
                        <!--  "old rate" × (1 - factor); factor of 1 implies no emergence, 0 implies no effect, -1 implies double the original emergence rate -->
                            <decay function="constant"/>
                        </emergenceReduction>
                    </anopheles>
                    <anopheles mosquito="gambiae_outdoor">
                        <emergenceReduction initial="@EIR_reduction@">
                        <!--  "old rate" × (1 - factor); factor of 1 implies no emergence, 0 implies no effect, -1 implies double the original emergence rate -->
                            <decay function="constant"/>
                        </emergenceReduction>
                    </anopheles>
                </description>
                <timed>
                    <!-- Varied times of deployment with two-year breaks -->
                    <deploy time="@step_change_time@"/>
                </timed>
            </intervention>
        </vectorPop>
        <importedInfections>
            <timed>
                <rate time="0" value="@importation_rate@"/>
            </timed>
        </importedInfections>
    </interventions>
    <healthSystem>
        <ImmediateOutcomes name="Tanzania ACT">
            <drugRegimen firstLine="ACT" inpatient="QN" secondLine="ACT"/>
      
            <initialACR>
                <ACT value="1"/>
                <QN value="1"/>
                <selfTreatment value="0"/>
            </initialACR>   
   
            <compliance>
                <ACT value="1"/>
                <selfTreatment value="0"/>
            </compliance>
      
          <nonCompliersEffective>   
            <ACT value="0"/>    
            <selfTreatment value="0"/>  
          </nonCompliersEffective>
             
            <treatmentActions>
                <ACT name="clear blood-stage infections">
                    <clearInfections stage="blood" timesteps="1"/>
                </ACT>
                <QN name="clear blood-stage infections">
                    <clearInfections stage="blood" timesteps="1"/>
                </QN>
            </treatmentActions>
      
            <pSeekOfficialCareUncomplicated1 value="@cm_clinical@"/>
            <pSelfTreatUncomplicated value="0.00"/>
            <pSeekOfficialCareUncomplicated2 value="@cm_clinical@"/>
            <pSeekOfficialCareSevere value="@cm_severe@"/>
            <!-- Default value to use 0.48 as in Tediosi et al., 2006 for reference scenario -->
            <!-- Modified to placeholder to allow dependency to cm_clinical being greater than 0.48 -->
        </ImmediateOutcomes>
